{
  "skill": "finding-unknowns-pitch-packager",
  "version": "1.0.0",
  "cases": [
    {
      "id": "e1",
      "description": "Should trigger: needs buy-in",
      "input": "Package this for the team review tomorrow.",
      "shouldTrigger": true,
      "assertions": ["Collects all artifacts", "Structures for a skeptic reader", "Includes 'what expert would ask' section"]
    },
    {
      "id": "e2",
      "description": "Should trigger: PR description",
      "input": "Write a PR description that covers what we did and why.",
      "shouldTrigger": true,
      "assertions": ["Matches medium to venue", "Keeps to one page with links"]
    },
    {
      "id": "n1",
      "description": "Not trigger: simple status update",
      "input": "What did we accomplish today?",
      "shouldTrigger": false,
      "assertions": ["Summarizes work", "Does not package for review"]
    }
  ]
}