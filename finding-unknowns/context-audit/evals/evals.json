{
  "skill": "finding-unknowns-context-audit",
  "version": "1.0.0",
  "cases": [
    {
      "id": "e1",
      "description": "Should trigger: bloated instructions",
      "input": "My CLAUDE.md has grown to 200 lines. Audit it.",
      "shouldTrigger": true,
      "assertions": ["Inventories every instruction layer", "Reads layers together", "Classifies instructions into 5 categories", "Proposes cuts as diff"]
    },
    {
      "id": "e2",
      "description": "Should trigger: agent ignoring instructions",
      "input": "The agent keeps ignoring its instructions. Something's wrong.",
      "shouldTrigger": true,
      "assertions": ["Finds contradictions between layers", "Reports before/after line counts"]
    },
    {
      "id": "n1",
      "description": "Not trigger: single file read",
      "input": "Read my CLAUDE.md and tell me what it says.",
      "shouldTrigger": false,
      "assertions": ["Reads and summarizes the file", "Does not enter full audit procedure"]
    }
  ]
}